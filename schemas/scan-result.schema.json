{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["target_url", "scanner_version", "duration_ms", "generated_at", "findings"],
  "properties": {
    "target_url": {"type": "string", "format": "uri"},
    "scanner_version": {"type": "string"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "format": "date-time"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "additionalProperties": false,
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "title", "owasp_category", "severity", "description", "evidence", "remediation"],
      "properties": {
        "id": {"type": "string"},
        "title": {"type": "string"},
        "owasp_category": {"type": "string"},
        "severity": {"enum": ["Critical", "High", "Medium", "Low", "Informational"]},
        "description": {"type": "string"},
        "evidence": {
          "type": "object",
          "required": ["request", "response_snippet"],
          "properties": {"request": {"type": "string"}, "response_snippet": {"type": "string", "maxLength": 2048}},
          "additionalProperties": false
        },
        "remediation": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
